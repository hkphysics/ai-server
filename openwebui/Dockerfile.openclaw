ARG OPENCLAW_TAG=slim
FROM ghcr.io/homebrew/brew:latest AS homebrew
FROM ghcr.io/openclaw/openclaw:${OPENCLAW_TAG}

USER root
ENV PYTHONDONTWRITEBYTECODE=1
COPY nodesource.sh .

RUN --mount=type=tmpfs,destination=/tmp \
    --mount=type=tmpfs,destination=/var/tmp \
    bash -E nodesource.sh && \
    DEBIAN_FRONTEND=noninteractive apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential python3-requests python3-pip curl \
        chromium-headless-shell jq tmux ffmpeg unzip && \
    apt-get clean && \
    rm -rf /usr/lib/python3.*/EXTERNALLY-MANAGED /var/cache/* /home/node/.npm /var/lib/apt/*

USER node

COPY --from=homebrew --chown=node:node /home/linuxbrew/.linuxbrew /home/linuxbrew/.linuxbrew

COPY --chmod=775 --chown=node:node install-openclaw.sh install-common.sh  /home/node

RUN --mount=type=secret,id=clawhub_api_key,uid=1000 \
    --mount=type=cache,target=/home/node/.cache,uid=1000,sharing=locked \
    CLAWHUB_API_KEY=$(cat /run/secrets/clawhub_api_key) \
    /home/node/install-openclaw.sh
